# WaveAssistDashboard build-time config (Vite bakes these at build).
# Cloud build: leave unset. Self-hosted build: set these.
VITE_DASHBOARD_BASE_URL=http://localhost:8000   # the box API base
VITE_AUTH_MODE=local                            # firebase (default) | local (UID login, no Google)
VITE_TELEMETRY=off                              # on (default) | off  (PostHog/GA)
VITE_BILLING=off                                # on (default) | off  (upgrade/credits UI)
VITE_MCP_URL=http://localhost:9000/mcp
VITE_LOCAL_UID=                                  # single-tenant box: baked admin UID => auto-login (no login page). blank = show UID field          # Connect-MCP endpoint shown in UI
# VITE_BRAND=waveassist

# JSON Firebase web config for the chosen brand when VITE_AUTH_MODE=firebase.
VITE_WAVEASSIST_FIREBASE_CONFIG=
VITE_GITZOID_FIREBASE_CONFIG=
VITE_WAVEASSIST_POSTHOG_KEY=
VITE_GITZOID_POSTHOG_KEY=
