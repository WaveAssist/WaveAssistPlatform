# ── Per-deployment config. The ONLY variable a Netlify site needs is VITE_BRAND —
#    Firebase config, the auth proxy, theming, and billing model are all derived from it.

# Which brand this build is. One of: waveassist | gitzoid.
VITE_BRAND=waveassist

# Optional overrides (rarely needed; sensible defaults live in code):
#   VITE_DASHBOARD_BASE_URL   backend API base (default https://api.waveassist.io)
#   VITE_DODO_MODE            test | live (default test)
