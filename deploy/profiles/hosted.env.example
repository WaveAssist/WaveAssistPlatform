# =============================================================================
# Profile: CONSOLIDATED HOSTED SERVICE
# The multi-tenant WaveAssist product, consolidated from ECS/RDS/ElastiCache/Atlas
# onto a single host. Firebase login, billing ON, shared worker fleet, local
# datastores. Existing data is migrated in; bootstrap is OFF.
#
#   cp deploy/profiles/hosted.env.example .env   # then fill every __CHANGE_ME__
#   docker compose build && docker compose up -d
# Rebuild `web` after changing any VITE_/auth/billing/telemetry/URL value.
# =============================================================================

# --- datastore + secrets (required; fail-closed) ---
DB_NAME=waveassist
DB_USER=waveassist
DB_PASSWORD=__CHANGE_ME__
DJANGO_SECRET_KEY=__CHANGE_ME__
WORKER_TOKEN=__CHANGE_ME__

# --- public URLs (the browser + SDK use these; must be the real hostnames) ---
PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
PUBLIC_MCP_URL=https://mcp.example.com/mcp

# --- deployment mode ---
WA_BOOTSTRAP_ADMIN=0            # migrated data already has users/accounts; do NOT seed
WA_AUTH=firebase               # real multi-user Google login
WA_BILLING=on                  # credits, metering, DoDo webhooks
WA_TELEMETRY=on                # explicit choice; set off to disable PostHog/GA
WA_WORKER_PROVISIONING=shared_queue   # one shared worker fleet, no per-tenant Fargate
WA_DB_PROVISIONING=local       # local Mongo, no Atlas Admin API
WA_STORAGE=local               # or s3 if you keep the existing buckets
WA_LOGS=local
WA_CATALOG=remote              # keep the hosted template catalog
COMPOSE_PROFILES=mcp

AGENTS_DIR=./agents
SECRETS_DIR=./secrets

# --- Firebase (required for WA_AUTH=firebase) ---
# Mount the service account under SECRETS_DIR (host) -> /run/secrets (container):
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
# Dashboard web Firebase config as compact JSON (baked at build):
VITE_WAVEASSIST_FIREBASE_CONFIG=__CHANGE_ME_JSON__
# VITE_GITZOID_FIREBASE_CONFIG=__CHANGE_ME_JSON__   # only if serving the gitzoid brand too

# --- billing (DoDo) + providers: set at cutover, see api/.env.example ---
# DODO_PAYMENTS_API_KEY=  DODO_DEFAULT_WEBHOOK_SECRET=  ... POSTMARK_API_TOKEN=  GITHUB_TOKEN=  ...

# --- host / CORS lock-down (set once DNS is final) ---
WA_ALLOWED_HOSTS=api.example.com,app.example.com,localhost,api,127.0.0.1
WA_CORS_ORIGINS=https://app.example.com
WA_CORS_ALLOW_ALL=0

# NOTE: migrate existing per-account queue assignments to the shared queue and
# restore MySQL + Mongo together BEFORE first boot. See deploy/profiles/README.md.
