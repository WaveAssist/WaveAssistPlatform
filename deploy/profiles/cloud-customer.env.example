# =============================================================================
# Profile: CUSTOMER CLOUD SERVER
# A single box on the customer's own cloud (e.g. an AWS VM), internet-connected.
# Password login, billing OFF, shared worker + local datastores, integrations
# and MCP available. Fresh setup with no hosted-WaveAssist account dependency.
#
#   cp deploy/profiles/cloud-customer.env.example .env   # fill every __CHANGE_ME__
#   docker compose build && docker compose up -d
# Rebuild `web` after changing any VITE_/auth/billing/telemetry/URL/brand value.
# =============================================================================

# --- datastore + secrets (required; fail-closed) ---
DB_NAME=waveassist
DB_USER=waveassist
DB_PASSWORD=__CHANGE_ME__
DJANGO_SECRET_KEY=__CHANGE_ME__
WORKER_TOKEN=__CHANGE_ME__

# --- admin identity (seeded on first boot) ---
WAVEASSIST_ADMIN_UID=__CHANGE_ME_24CHARS__      # e.g. `openssl rand -hex 12`
WAVEASSIST_ADMIN_EMAIL=admin@customer.example

# --- public URLs (real hostnames; behind your TLS reverse proxy) ---
PUBLIC_API_URL=https://api.customer.example
PUBLIC_APP_URL=https://app.customer.example
PUBLIC_MCP_URL=https://mcp.customer.example/mcp

# --- deployment mode ---
WA_BOOTSTRAP_ADMIN=1           # seed the single admin User+Account on first boot
WA_AUTH=password
WA_ADMIN_USERNAME=admin
WA_ADMIN_PASSWORD=__CHANGE_ME__   # dashboard warns until this is changed from the default
WA_BILLING=off                 # no credits/trial/checkout gating
WA_TELEMETRY=off               # no PostHog/GA/GTM (verified: zero Google traffic)
WA_WORKER_PROVISIONING=shared_queue
WA_DB_PROVISIONING=local
WA_STORAGE=local
WA_LOGS=local
WA_CATALOG=local               # no dependency on the hosted template catalog
VITE_BRAND=gitzoid             # brand the dashboard (waveassist | gitzoid)
COMPOSE_PROFILES=mcp

AGENTS_DIR=./agents
SECRETS_DIR=./secrets

# --- private repository / GitHub workload (set when needed) ---
# Agent authoring via MCP deploy AND user repo OAuth need GitHub configured:
#   GITHUB_TOKEN=__PAT_with_repo_scope__     GITHUB_USERNAME=__owner__
# For the user-facing repo picker, also seed a Provider row (see README) and:
#   JWT_SECRET=__CHANGE_ME__
# Agents can instead be imported from disk (deploy_local_agent) with no GitHub.

# --- LLM (set one; call_llm needs it, billing off does not gate it) ---
# Set via the dashboard or: data/set_data_for_key key `open_router_key` = <OpenRouter key>

# --- host / CORS lock-down ---
WA_ALLOWED_HOSTS=api.customer.example,app.customer.example,localhost,api,127.0.0.1
WA_CORS_ORIGINS=https://app.customer.example
WA_CORS_ALLOW_ALL=0
