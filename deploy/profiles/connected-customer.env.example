# =============================================================================
# Profile: CUSTOMER CONNECTED SERVER
# The customer's own hardware, internet-connected, reaching private-network data
# sources. Password (or no-login trusted) mode, billing OFF, local datastores,
# reporting/PDF workload. NOT air-gapped: provider/internet access is expected.
#
#   cp deploy/profiles/connected-customer.env.example .env   # fill __CHANGE_ME__
#   # reporting/DB-driver workload -> build the worker with agent extras:
#   docker compose build --build-arg INSTALL_AGENT_EXTRAS=1 worker
#   docker compose build && docker compose up -d
# =============================================================================

# --- datastore + secrets (required; fail-closed) ---
DB_NAME=waveassist
DB_USER=waveassist
DB_PASSWORD=__CHANGE_ME__
DJANGO_SECRET_KEY=__CHANGE_ME__
WORKER_TOKEN=__CHANGE_ME__

# --- admin identity (seeded on first boot) ---
WAVEASSIST_ADMIN_UID=__CHANGE_ME_24CHARS__
WAVEASSIST_ADMIN_EMAIL=admin@customer.example

# --- public URLs (real host/IP; behind your TLS proxy) ---
PUBLIC_API_URL=https://reports.customer.example
PUBLIC_APP_URL=https://reports.customer.example
PUBLIC_MCP_URL=https://reports.customer.example/mcp

# --- deployment mode ---
WA_BOOTSTRAP_ADMIN=1
WA_AUTH=password               # or `local` for no-login trusted access (baked UID auto-enter)
WA_ADMIN_USERNAME=admin
WA_ADMIN_PASSWORD=__CHANGE_ME__
WA_BILLING=off
WA_TELEMETRY=off
WA_WORKER_PROVISIONING=shared_queue
WA_DB_PROVISIONING=local
WA_STORAGE=local
WA_LOGS=local
WA_CATALOG=local
VITE_BRAND=waveassist
COMPOSE_PROFILES=mcp

AGENTS_DIR=./agents
SECRETS_DIR=./secrets

# --- reporting delivery: email via the customer's own SMTP relay ---
# WA_SMTP_SERVER=smtp.customer.example
# WA_SMTP_PORT=587
# MAILER_LOGIN_EMAIL=reports@customer.example
# MAILER_LOGIN_EMAIL_PASSWORD=__CHANGE_ME__
# WA_FROM_EMAIL=Reports <reports@customer.example>
# (or POSTMARK_API_TOKEN=__CHANGE_ME__ with a verified sender domain)

# --- private data-source drivers are baked when INSTALL_AGENT_EXTRAS=1 (MSSQL/MySQL,
#     headless Chromium). WeasyPrint PDF libraries are always in the worker image. ---

# --- LLM (optional; only if agents use call_llm): set `open_router_key` in the KV store ---

# --- host / CORS lock-down ---
WA_ALLOWED_HOSTS=reports.customer.example,localhost,api,127.0.0.1
WA_CORS_ORIGINS=https://reports.customer.example
WA_CORS_ALLOW_ALL=0
