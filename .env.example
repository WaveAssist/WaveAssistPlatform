DB_NAME=waveassist
DB_USER=waveassist
DB_PASSWORD=CHANGE_ME
DJANGO_SECRET_KEY=CHANGE_ME
WORKER_TOKEN=CHANGE_ME
PUBLIC_API_URL=http://localhost:8000
PUBLIC_MCP_URL=http://localhost:9000/mcp
WAVEASSIST_ADMIN_UID=boxadmin000000000000admin
WAVEASSIST_ADMIN_EMAIL=admin@waveassist.local

# Independent deployment choices. Rebuild web when auth/billing/telemetry URLs change.
WA_BOOTSTRAP_ADMIN=1
WA_AUTH=password
WA_ADMIN_USERNAME=admin
WA_ADMIN_PASSWORD=CHANGE_ME
WA_WORKER_PROVISIONING=shared_queue
WA_DB_PROVISIONING=local
WA_BILLING=off
WA_STORAGE=local
WA_LOGS=local
WA_CATALOG=remote
WA_TELEMETRY=off
# Leave empty to omit the bundled MCP service.
COMPOSE_PROFILES=mcp
PUBLIC_APP_URL=http://localhost:8080
AGENTS_DIR=./agents
SECRETS_DIR=./secrets
# For Firebase auth, mount the service account in SECRETS_DIR and set:
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
# Provider credentials are read by the API from this file; see API .env.example.
